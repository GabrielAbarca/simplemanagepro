---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  class?: string;
}

const {
  light,
  dark,
  alt,
  widths,
  sizes,
  loading = "lazy",
  priority = false,
  class: className,
} = Astro.props;

const [lightImg, darkImg] = await Promise.all([
  getImage({ src: light, widths, sizes, format: "webp" }),
  getImage({ src: dark, widths, sizes, format: "webp" }),
]);
---

{/*
  The dark captures were shot from the first commit and never used, so a
  dark-mode visitor got light screenshots on a dark page — the one place the
  page contradicted itself most visibly.

  <picture> alone only solves half of it. Its `media` is evaluated against the
  OS preference, so it cannot see the page's own theme toggle. The fix is for
  the toggle to rewrite this source's `media` to `all` / `not all` (see
  Header.astro), which makes the browser re-run selection.

  Doing it this way rather than shipping both images and hiding one in CSS
  keeps it to a single download: <picture> fetches only the selected source,
  and the dark file is requested only if a visitor actually switches.
*/}
<picture class={className}>
  <source
    data-dark-source
    srcset={darkImg.srcSet.attribute}
    sizes={sizes}
    type="image/webp"
    media="(prefers-color-scheme: dark)"
  />
  <source srcset={lightImg.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={lightImg.src}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={loading}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : "auto"}
  />
</picture>
