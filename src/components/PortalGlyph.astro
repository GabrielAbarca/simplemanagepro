---
/**
 * A console drawn as a wireframe, in the portal's own accent.
 *
 * Deliberately NOT a screenshot thumbnail. A 1280px console rendered into a
 * 340px card is 0.27x, which is illegible mush — the exact failure this pass
 * exists to remove, reintroduced at card scale. What a card needs is the
 * SHAPE of each console, and the three shapes genuinely differ: the dirección
 * console is a grid of tiles, the docente console is a table, the estudiante
 * portal is tiles plus a rail. Drawn at 160x104 it stays crisp at any size and
 * costs no request.
 *
 * Decorative: every instance is aria-hidden, and the caption beside it carries
 * the meaning.
 */
interface Props {
  variant: "direccion" | "docente" | "estudiante";
  class?: string;
}

const { variant, class: className } = Astro.props;

/** Sidebar with rounded left corners only, so it sits inside the frame. */
const SIDEBAR = "M8 1h27v102H8a7 7 0 0 1-7-7V8a7 7 0 0 1 7-7Z";
---

<svg
  class:list={["glyph", className]}
  viewBox="0 0 160 104"
  role="presentation"
  aria-hidden="true"
>
  <rect
    class="frame"
    x="0.75"
    y="0.75"
    width="158.5"
    height="102.5"
    rx="7.5"
  />
  <path class="chrome" d={SIDEBAR} />

  {/* Nav rail, identical across the three: it is the same product. */}
  <rect class="nav is-on" x="5" y="14" width="25" height="7" rx="3.5" />
  {[30, 43, 56, 69].map((y) => (
    <rect class="nav" x="7" y={y} width="19" height="4" rx="2" />
  ))}

  {variant === "direccion" && (
    <>
      {/* Curso lectivo, periodos, secciones: a board of counters. */}
      <rect class="title" x="43" y="13" width="52" height="7" rx="3.5" />
      {[0, 1, 2].map((c) =>
        [0, 1].map((r) => (
          <rect
            class="tile"
            x={43 + c * 36}
            y={29 + r * 30}
            width="30"
            height="24"
            rx="5"
          />
        )),
      )}
      {[0, 1, 2].map((c) =>
        [0, 1].map((r) => (
          <rect
            class="mark"
            x={47 + c * 36}
            y={35 + r * 30}
            width="10"
            height="5"
            rx="2.5"
          />
        )),
      )}
    </>
  )}

  {variant === "docente" && (
    <>
      {/* The libro de notas: a roster with a grade at the end of every row. */}
      <rect class="title" x="43" y="12" width="46" height="7" rx="3.5" />
      <rect class="tab is-on" x="43" y="25" width="22" height="4" rx="2" />
      <rect class="tab" x="70" y="25" width="18" height="4" rx="2" />
      <rect class="tab" x="93" y="25" width="18" height="4" rx="2" />
      {[0, 1, 2, 3, 4].map((r) => (
        <>
          <rect
            class="row"
            x="43"
            y={37 + r * 13}
            width="108"
            height="9"
            rx="3"
          />
          <rect
            class="grade"
            x={132}
            y={39.5 + r * 13}
            width="14"
            height="4"
            rx="2"
          />
        </>
      ))}
    </>
  )}

  {variant === "estudiante" && (
    <>
      {/* Promedio and asistencia up top, notas below, cartelera on the rail. */}
      <rect class="title" x="43" y="12" width="38" height="7" rx="3.5" />
      {[0, 1, 2].map((c) => (
        <rect
          class="tile"
          x={43 + c * 25}
          y={26 + 0}
          width="21"
          height="21"
          rx="5"
        />
      ))}
      <circle class="mark" cx="53.5" cy="36.5" r="5" />
      <circle class="mark" cx="78.5" cy="36.5" r="5" />
      <circle class="mark" cx="103.5" cy="36.5" r="5" />
      {[0, 1, 2].map((r) => (
        <rect
          class="row"
          x="43"
          y={54 + r * 13}
          width="71"
          height="9"
          rx="3"
        />
      ))}
      <rect class="rail" x="121" y="26" width="30" height="65" rx="5" />
      {[0, 1, 2].map((r) => (
        <rect
          class="nav"
          x="126"
          y={33 + r * 14}
          width="20"
          height="4"
          rx="2"
        />
      ))}
    </>
  )}
</svg>

<style>
  /* Everything is currentColor at a different weight, so the whole glyph
     re-tints from one property on the parent. */
  .glyph {
    display: block;
    width: 100%;
    height: auto;
    color: var(--accent, var(--color-primary-fill));
  }

  .frame {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    opacity: 0.3;
  }

  .chrome {
    fill: currentColor;
    opacity: 0.07;
  }

  .nav {
    fill: currentColor;
    opacity: 0.28;
  }
  .nav.is-on {
    opacity: 0.55;
  }

  .title {
    fill: currentColor;
    opacity: 0.45;
  }

  .tile,
  .rail {
    fill: currentColor;
    opacity: 0.1;
  }

  .row {
    fill: currentColor;
    opacity: 0.09;
  }

  .grade,
  .mark {
    fill: currentColor;
    opacity: 0.5;
  }

  .tab {
    fill: currentColor;
    opacity: 0.22;
  }
  .tab.is-on {
    opacity: 0.6;
  }
</style>
