---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * The hero's product fragment, which has to switch on TWO axes at once.
 *
 * Theme, like every other screenshot on the site. And viewport, which is new:
 * a fragment is only legible when it is displayed at roughly the size the app
 * drew it at, and the desktop crop is 680 CSS px against about 358px of usable
 * width on a phone. Serving one to both is the 0.42x problem the old hero had.
 * So the phone gets its own capture, shot at 390px.
 *
 * Four sources, most specific first. <picture> takes the first whose media
 * matches, so the mobile pair has to precede the desktop pair.
 *
 * `data-dark-source` carries the EXTRA condition that survives the theme
 * rewrite, empty for the desktop source. Header.astro's syncShots() reads it:
 * on dark it sets media to that condition (or "all" when blank), on light to
 * "not all". The light sources keep their static viewport media, so they are
 * what remains once the dark ones are switched off.
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  mobileLight: ImageMetadata;
  mobileDark: ImageMetadata;
  alt: string;
  /** CSS px the desktop crop is displayed at; 1:1 with the app at width / 2. */
  displayWidth: number;
  mobileDisplayWidth: number;
  breakpoint?: number;
  class?: string;
}

const {
  light,
  dark,
  mobileLight,
  mobileDark,
  alt,
  displayWidth,
  mobileDisplayWidth,
  breakpoint = 1000,
  class: className,
} = Astro.props;

const narrow = `(max-width: ${breakpoint - 1}px)`;
const desktopSizes = `${displayWidth}px`;
const mobileSizes = `${mobileDisplayWidth}px`;

// Two DPR steps each. Beyond 2x the crop is already denser than any phone can
// resolve, and these are the largest images above the fold.
const [d1, d2, m1, m2] = await Promise.all([
  getImage({
    src: light,
    widths: [displayWidth, displayWidth * 2],
    sizes: desktopSizes,
    format: "webp",
  }),
  getImage({
    src: dark,
    widths: [displayWidth, displayWidth * 2],
    sizes: desktopSizes,
    format: "webp",
  }),
  getImage({
    src: mobileLight,
    widths: [mobileDisplayWidth, mobileDisplayWidth * 2],
    sizes: mobileSizes,
    format: "webp",
  }),
  getImage({
    src: mobileDark,
    widths: [mobileDisplayWidth, mobileDisplayWidth * 2],
    sizes: mobileSizes,
    format: "webp",
  }),
]);
---

<picture class={className}>
  <source
    data-dark-source={narrow}
    srcset={m2.srcSet.attribute}
    sizes={mobileSizes}
    type="image/webp"
    media={`${narrow} and (prefers-color-scheme: dark)`}
  />
  <source
    srcset={m1.srcSet.attribute}
    sizes={mobileSizes}
    type="image/webp"
    media={narrow}
  />
  <source
    data-dark-source=""
    srcset={d2.srcSet.attribute}
    sizes={desktopSizes}
    type="image/webp"
    media="(prefers-color-scheme: dark)"
  />
  <source srcset={d1.srcSet.attribute} sizes={desktopSizes} type="image/webp" />
  <img
    src={d1.src}
    alt={alt}
    width={light.width}
    height={light.height}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
  />
</picture>
