---
import ConsoleShot from "../ConsoleShot.astro";
import ConsoleFrame from "../ConsoleFrame.astro";
import { DEMO_URL } from "../../config";
import { portals } from "../../data/site";

const admin = portals[0];
---

<section class="hero fold-hero">
  <!-- The fold. The brand mark is a crimson ribbon folded back on itself, and
       this is that shape at page scale. Geometry lives in base.css; the hero
       only sets where the crease crosses, which here is right where the copy
       ends and the console begins, so the product reads as resting on the
       turned-back face of the sheet. -->
  <div class="fold" aria-hidden="true">
    <span class="face face-up"></span>
    <span class="face face-down"></span>
    <span class="crease"></span>
    <span class="rule"></span>
  </div>

  <div class="wrap">
    <!-- The headline splits across the row rather than stacking above it.
         Stacked, the claim ran four lines down the left and left the entire
         upper right of the hero empty, and it pushed the console almost
         entirely below the fold — on the one page whose job is to show the
         product. Set against the lede and the CTAs it fills the band, and the
         console clears the fold on a laptop. -->
    <div class="hero-copy">
      <div class="copy-split">
        <div>
          <p class="eyebrow">Hecho para Costa Rica</p>
          <h1>El sistema con el que su colegio lleva el curso lectivo.</h1>
        </div>
        <div class="copy-aside">
          <p class="lede">
            Notas, asistencia, horarios y expedientes en un solo lugar: para la
            dirección, para los docentes y para los estudiantes.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href={DEMO_URL}>Ver la demo</a>
            <a class="btn btn-quiet" href="/piloto">Conocer el piloto 2027</a>
          </div>
          <p class="note">
            Es un colegio de ejemplo, con datos de ejemplo. Nada de lo que haga
            ahí se guarda.
          </p>
        </div>
      </div>
    </div>

    <!-- Two planes in one perspective space.
         The stage owns the perspective rather than each frame carrying its
         own, which is the difference between a composition with depth and two
         separately skewed rectangles. The phone sits on a positive Z, so it is
         genuinely in front of the console rather than merely overlapping it.

         Both are whole frames. The capture is shot at 1280 CSS px and the
         console is displayed at 1240, so it renders at 1:1 with the app's own
         pixels, and the source is 3x, so no browser has to stretch it. See the
         .stage rules below for why the tilt does not undo that. -->
    <!-- The planes are wrappers this component owns, not classes handed to
         ConsoleFrame. Astro does not put a parent's scope attribute on a child
         component's root element, so `class="plane"` on <ConsoleFrame> renders
         the class but never matches the rule that styles it. -->
    <div class="stage" data-tilt>
      <div class="plane plane-console">
        <ConsoleFrame>
          <ConsoleShot
            light={admin.image}
            dark={admin.imageDark}
            mobileLight={admin.mobileImage}
            mobileDark={admin.mobileImageDark}
            alt={admin.alt}
            displayWidth={1240}
            sizes="(min-width: 1292px) 1240px, calc(100vw - 3.2rem)"
            mobileDisplayWidth={300}
            loading="eager"
            priority={true}
          />
        </ConsoleFrame>
      </div>

      {/* Second plane. Hidden below the breakpoint, where ConsoleShot has
          already swapped the frame above to this same phone capture and it
          would be the same picture twice. Decorative there, so no alt. */}
      <div class="plane plane-phone">
        <ConsoleFrame phone>
          <ConsoleShot
            light={admin.mobileImage}
            dark={admin.mobileImageDark}
            alt=""
            displayWidth={270}
            loading="eager"
          />
        </ConsoleFrame>
      </div>
    </div>
  </div>
</section>

<style>
  /* THE CONSTRAINT ON THESE TWO NUMBERS.
   *
   * Both ends of the crease must land between the console's top and its
   * bottom. The console is opaque and nearly the full width, so a crease
   * placed there is hidden behind the product and shows only as two short
   * diagonal stubs in the gutters either side, which is the sheet continuing
   * behind the thing resting on it.
   *
   * Anywhere higher and it crosses copy: at 22% it ran through the lede, and
   * an earlier pass at 44% ran it through the CTA row, where a crease reads as
   * a stray line rather than as an edge. Anywhere lower and it lands under the
   * console in the run-out to the next section, where it competes with that
   * section's own fold-band edge.
   *
   * The band is narrow and moves with the viewport, so measure rather than
   * eyeball if you change the hero's layout: at 1440 the console runs from 32%
   * to 88% of the hero, at 1024 from 35% to 86%.
   */
  .hero {
    --fold-left: 56%;
    --fold-right: 40%;
    padding-block: var(--space-5) var(--space-6);
  }

  /* Between the two breakpoints the console is still the desktop frame but the
     headline has not split yet, so the copy is a good 200px taller and the
     desktop percentages put the crease back through it. */
  @media (min-width: 760px) and (max-width: 999px) {
    .hero {
      --fold-left: 68%;
      --fold-right: 56%;
    }
  }

  /* Stacked, the copy is taller again and the phone frame starts far lower. */
  @media (max-width: 759px) {
    .hero {
      --fold-left: 62%;
      --fold-right: 52%;
    }
  }

  /* Wider than the 1180px the rest of the page uses: 1240px of content is what
     puts the console at 1:1 with the app, and that ratio is the whole fix. */
  .hero .wrap {
    max-width: 1292px;
  }

  .hero-copy {
    /* Entrance, not a scroll reveal: this is above the fold on every screen,
       so a scroll sweep would fire immediately anyway. */
    animation: rise var(--dur-slow) var(--ease-out) both;
    margin-bottom: var(--space-5);
  }

  .copy-split {
    display: grid;
    gap: var(--space-4);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    max-width: 18ch;
  }
  .hero .lede {
    margin-top: 0;
  }
  .hero .note {
    max-width: 44ch;
  }

  @media (min-width: 1000px) {
    .copy-split {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-5);
      align-items: end;
    }
    .copy-aside {
      /* Sits on the headline's own baseline rather than floating beside its
         middle, which is what makes the two columns read as one block. */
      padding-bottom: 0.4rem;
    }
  }

  .stage {
    position: relative;
    animation: rise var(--dur-slow) 140ms var(--ease-out) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
  }

  /* ── The two planes ─────────────────────────────────────────────────── */

  /* WHY A TILTED SCREENSHOT STAYS SHARP HERE.
   *
   * A perspective transform resamples a screenshot, and an earlier pass of
   * this hero dropped the tilt for exactly that reason. That was the wrong
   * conclusion: what damages a screenshot is MAGNIFICATION, not rotation.
   * Perspective scales a point by p / (p - z). Rotating about the RIGHT edge
   * with a negative rotateY sends every other point to a negative z, so the
   * factor is at most 1.0 at that edge and below 1.0 everywhere else. The
   * plane can only ever be minified, which is what a downsample is, and the
   * source carries 3x for a frame displayed at 1x.
   *
   * The rule that follows: keep the origin on the edge the rotation brings
   * forward, and keep rotateY negative. A centred origin, or a positive
   * rotateY, pulls the near half toward the viewer and starts upscaling it.
   * The pointer parallax below is clamped for the same reason.
   */
  @media (min-width: 760px) {
    .stage {
      perspective: 1800px;
      /* Set by the pointer script; these are the resting values. */
      --ry: -7deg;
      --rx: 2.5deg;
    }

    .plane {
      transform: rotateY(var(--ry)) rotateX(var(--rx));
      transform-origin: right center;
      transition: transform var(--dur-slow) var(--ease-out);
    }

    /* In front of the console, not merely on top of it.
       Placed bottom-RIGHT because that is the only large empty region of the
       admin overview: the stat grid stops around two thirds across and the
       column to its right carries nothing but background. On the left it
       covered the entire sidebar, which is a real part of the product. Right
       is also the edge the rotation brings forward, so a plane in front of it
       there is where the eye expects one. */
    .plane-phone {
      position: absolute;
      right: 0;
      bottom: -2.5rem;
      z-index: 1;
      margin-inline: 0;
      translate: 12% 0;
      transform: translateZ(70px) rotateY(var(--ry)) rotateX(var(--rx));
      transform-origin: right center;
    }
  }

  /* Below the breakpoint the console frame is already holding the phone
     capture, so the second plane would be the same picture twice — and a
     sheared table at 360px is the unreadability this hero exists to fix. */
  @media (max-width: 759px) {
    .plane-phone {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .stage {
      animation: none;
    }
    .plane {
      transition: none;
    }
  }
</style>

<script>
  // Pointer parallax on the two planes.
  //
  // It writes two custom properties on the stage rather than a transform on
  // each plane: the planes differ (one carries a translateZ, and they rotate
  // about opposite edges), so rewriting whole transform strings from here
  // would mean this script owning geometry that belongs in the stylesheet.
  //
  // Fine pointers only. On a touchscreen there is no hover state to respond
  // to, so it would simply never move.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const stage = document.querySelector<HTMLElement>("[data-tilt]");
  const fine = matchMedia("(pointer: fine)");

  if (stage && fine.matches && !reduced.matches) {
    let frame = 0;

    const move = (ev: PointerEvent) => {
      if (frame) return; // coalesce to one write per animation frame
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (innerWidth < 760) return; // the flat layout owns the transform
        const r = stage.getBoundingClientRect();
        // −0.5…0.5 from the stage's own centre.
        const px = (ev.clientX - r.left) / r.width - 0.5;
        const py = (ev.clientY - r.top) / r.height - 0.5;
        // Clamped to stay negative. A positive rotateY would swing the near
        // half of the console toward the viewer and start upscaling it, which
        // is the one thing that visibly softens a screenshot.
        stage.style.setProperty("--ry", `${-7 + px * 4}deg`);
        stage.style.setProperty("--rx", `${2.5 - py * 3}deg`);
      });
    };

    const reset = () => {
      stage.style.removeProperty("--ry");
      stage.style.removeProperty("--rx");
    };

    addEventListener("pointermove", move, { passive: true });
    stage.addEventListener("pointerleave", reset);
  }
</script>
