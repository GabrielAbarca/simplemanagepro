---
import ConsoleShot from "../ConsoleShot.astro";
import DeviceFrame from "../DeviceFrame.astro";
import { DEMO_URL } from "../../config";
import { portals } from "../../data/site";

const [admin, docente, estudiante] = portals;

// Written out rather than derived from `label`. The three labels are not one
// pattern ("Consola de la dirección", "Consola del docente", "Portal del
// estudiante"), so a regex that strips the prefix leaves "Portal del
// estudiante" sitting next to two bare nouns. These are presentation, and the
// key needs three words of the same shape.
const key = [
  { name: "Dirección", accent: admin.accent },
  { name: "Docentes", accent: docente.accent },
  { name: "Estudiantes", accent: estudiante.accent },
];
---

<section class="hero fold-hero" data-tilt>
  <!-- The fold. The brand mark is a crimson ribbon folded back on itself, and
       this is that shape at page scale. Geometry lives in base.css; the hero
       only sets where the crease crosses. -->
  <div class="fold" aria-hidden="true">
    <span class="face face-up"></span>
    <span class="face face-down"></span>
    <span class="crease"></span>
    <span class="rule"></span>
  </div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Hecho para Costa Rica</p>
      <h1>Tres consolas. Un solo sistema.</h1>
      <p class="lede">
        La dirección configura, los docentes califican y los estudiantes
        consultan. Todo sobre los mismos datos.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={DEMO_URL}>Ver la demo</a>
        <a class="btn btn-quiet" href="/piloto">Conocer el piloto 2027</a>
      </div>
      <p class="note">
        Es un colegio de ejemplo, con datos de ejemplo. Nada de lo que haga ahí
        se guarda.
      </p>
    </div>

    <!-- Below the breakpoint only one console is legible, so the other two
         keep their claim in words.

         It sits BEFORE the lineup in the source, which matters: after it, the
         collapsed layout put the key underneath a device that is 884px tall
         and bleeding past the viewport, so the one element carrying the
         three-console idea on a phone landed at y1478 and was clipped out of
         the page entirely. -->
    <ul class="portal-key">
      {
        key.map((k) => <li style={`--accent: ${k.accent}`}>{k.name}</li>)
      }
    </ul>

    <!-- THE LINEUP.
         Three consoles, three devices, one perspective, and the page's thesis
         moved into the first viewport instead of 900px down it.

         It fits because each device behind is partly occluded by the one in
         front. Nothing is scaled to make room, which is the only way three
         whole consoles stay legible at once.

         WHY EVERY DEVICE SITS AT OR BEHIND z=0. Perspective scales a point by
         p / (p - z), so a positive translateZ pulls a plane toward the viewer
         and MAGNIFIES it, and magnification is the one transform that visibly
         softens a screenshot. Depth is built by pushing the back devices away
         instead: the phone is the reference at 0 and everything behind it is
         minified, which is only ever a downsample. The same reasoning governs
         the rotation, which is about the right edge with a negative rotateY so
         no point comes forward, and the pointer parallax below is clamped to
         keep it that way.

         The cost, stated plainly rather than buried: the console draws at
         about 0.93 of 1240, so it is no longer pixel-for-pixel with the app.
         It is still a clean downsample from a 2x source. -->
    <div class="rig">
      <div class="dev dev-monitor">
        <DeviceFrame kind="monitor" screenWidth={1000} accent={admin.accent}>
          <ConsoleShot
            light={admin.image}
            dark={admin.imageDark}
            alt={admin.alt}
            displayWidth={1240}
            loading="lazy"
          />
        </DeviceFrame>
      </div>

      <div class="dev dev-tablet">
        <DeviceFrame kind="tablet" screenWidth={720} accent={docente.accent}>
          <ConsoleShot
            light={docente.tabletImage!}
            dark={docente.tabletImageDark!}
            alt={docente.alt}
            displayWidth={1180}
            loading="lazy"
          />
        </DeviceFrame>
      </div>

      <!-- The phone changes console at the breakpoint, which is the one place
           this hero is asymmetric on purpose. Above it the phone is the
           estudiante portal and the lineup reads as three. Below it the other
           two devices are gone, so whatever is in the phone IS the hero image,
           and the person holding that phone is far more likely to be the
           director deciding than a student. So it carries the dirección
           console there, and the rim follows it. -->
      <div class="dev dev-phone">
        <DeviceFrame kind="phone" screenWidth="var(--phone-w)">
          <ConsoleShot
            light={estudiante.mobileImage}
            dark={estudiante.mobileImageDark}
            mobileLight={admin.mobileImage}
            mobileDark={admin.mobileImageDark}
            alt={admin.alt}
            displayWidth={330}
            mobileDisplayWidth={280}
            mobileSizes="min(280px, 58vw)"
            breakpoint={1000}
            loading="eager"
            priority={true}
          />
        </DeviceFrame>
      </div>
    </div>

  </div>
</section>

<style>
  /* THE CONSTRAINT ON THESE TWO NUMBERS.
   *
   * The crease must clear the copy on the left and may hide behind a device on
   * the right, so it rakes steeply upward rather than running shallow across
   * the middle the way it did when the copy was a full-width band. At a locked
   * viewport height the copy occupies most of the left column, which leaves
   * the crease almost no room there: it goes near the bottom on that edge and
   * mid-height on the other.
   *
   * The band is narrow and moves with the viewport, so measure rather than
   * eyeball. `npm run check:crease` asserts it at eight widths and treats
   * console frames as cover; it does NOT know about .device, so the copy is
   * what has to stay clear.
   */
  .hero {
    position: relative;
    /* block, with .hero-inner taking the height explicitly. As a flex parent
       the inner box would not stretch: it settled at 629px inside an 834px
       hero and centred itself, which pushed the copy 103px down, straight into
       the phone and the tablet. Type over device hardware is the one thing the
       fold rules forbid outright, and it failed the contrast audit at 4.39:1.
       Deterministic beats clever here. */
    display: block;
    /* Two floors, and the taller one wins.
     *
     * The first is the viewport, so the hero always fills one screen. That is
     * what a fixed height used to guarantee, but a fixed height also meant
     * .fold-hero's clip cut the tablet and the phone off at the hero's bottom
     * edge and no amount of scrolling revealed the rest: they read as broken
     * rather than as bled.
     *
     * The second is the lineup's own extent, added per breakpoint below, so
     * the hero continues past the first screen far enough to hold the devices
     * whole. It is not set here because the collapsed layout has no lineup:
     * the phone is in flow there and the hero already grows to fit it, so a
     * desktop floor would only pad a phone with dead space.
     *
     * overflow:hidden STAYS. Nothing is clipped vertically now, and it is
     * still what lets the phone bezel bleed off both edges at 390. */
    min-height: calc(100svh - var(--header-h));
    /* base.css gives every <section> 6.4rem of block padding. A hero that owns
       its own height cannot also carry it: it took 102.4px off the top and the
       bottom, so .hero-inner was 629px inside an 834px hero and the copy began
       102px lower than align-content:start put it. The inner box owns the
       spacing here. */
    padding-block: 0;
    --fold-left: 97%;
    --fold-right: 40%;
    /* Set by the pointer script; these are the resting values. */
    --ry: -8deg;
    --rx: 3deg;
    --phone-w: 330px;
  }

  /* The fold covers the FIRST SCREEN, not the whole hero.
     Its clip-path percentages are of this element, so letting it span a hero
     that now runs to 1400px would drag the crease hundreds of px below the
     fold line and the signature would be missing from the one screen it
     exists for. Where the element ends, `.face-down` is already
     --color-background, so there is no seam against the page below it.
     crease-check.mjs measures off this box too, so it follows automatically. */
  .hero > .fold {
    bottom: auto;
    height: calc(100svh - var(--header-h));
  }

  .hero-inner {
    position: relative;
    z-index: 4;
    width: 100%;
    /* No height. The hero's height comes from min-height now, so its computed
       `height` is auto and a percentage here resolves to auto anyway. The grid
       is align-content:start, so the copy sits at the top regardless. */
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-3);
    display: grid;
    /* minmax(0, 1fr), not the implicit `auto`. The phone is deliberately wider
       than the gutter allows on a small screen, and an auto track takes its
       max-content width as a floor: the column grew to the device's width and
       dragged the copy out past the right edge with it. */
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    justify-items: start;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-2);
    width: min(27rem, 100%);
    /* Entrance, not a scroll reveal: this is above the fold on every screen,
       so a scroll sweep would fire immediately anyway. */
    animation: rise var(--dur-slow) var(--ease-out) both;
  }

  /* The copy stack is a grid and the gap owns the rhythm. base.css gives
     .eyebrow and .lede their own margins for the flow layouts everywhere else,
     and left in place they stack on top of the gap: about 70px of the copy
     block was margin nobody asked for, which is 70px of console on the phone. */
  .hero-copy > * {
    margin: 0;
  }

  .hero h1 {
    font-size: clamp(1.9rem, 2.9vw, 2.55rem);
    max-width: 14ch;
  }
  .hero .lede {
    font-size: 1.05rem;
    max-width: 32ch;
  }
  .hero .note {
    max-width: 36ch;
  }
  .hero .cta-row {
    margin-top: var(--space-1);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
  }

  /* ── The lineup ───────────────────────────────────────────────────────── */

  /* Breaks out of the 1180px column to span the viewport, so the placements
     below are percentages of the window rather than of the text measure. */
  /* The lineup's floor. The phone is the lowest device, and this has to clear
     its transformed bottom edge or .fold-hero's clip cuts the device off.

     89rem was correct when the phone was 884px tall. It has been 784 since the
     lineup's widths were cut (monitor 1000, tablet 720, phone 330), which left
     149px of empty hero under the devices at every desktop size — measured at
     1280x900, 1440x900, 1280x760 and 1600x1000, all within a pixel of each
     other, because the slack is a constant, not a function of the window.

     83rem (1328) puts the phone's bottom about 50px above the hero's, which is
     the same margin 89rem gave the taller phone. Measured with
     getBoundingClientRect, which already reports the tilted box, so the ~21px
     the rotation adds is inside the number rather than added to it.
     Move either device's `top`, or any screenWidth, and re-measure this. */
  @media (min-width: 1000px) {
    .hero {
      min-height: max(calc(100svh - var(--header-h)), 83rem);
    }
  }

  .rig {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 100vw;
    height: 100%;
    z-index: -1;
    perspective: 2000px;
    perspective-origin: 68% 38%;
    pointer-events: none;
  }

  .dev {
    position: absolute;
    transform-origin: right center;
    transition: transform var(--dur-slow) var(--ease-out);
    animation: rise var(--dur-slow) var(--ease-out) both;
  }

  .dev-monitor {
    left: 45%;
    top: 3%;
    transform: translateZ(-150px) rotateY(var(--ry)) rotateX(var(--rx));
    animation-delay: 120ms;
  }

  /* The two lower devices start below the copy block, not merely behind it:
     both run under the copy column horizontally, so clearing it is a vertical
     job, and type over device hardware is what the contrast audit catches.

     Anchored in rem rather than in per cent of the hero. The copy is a fixed
     stack whose height does not shrink with the window, so a percentage that
     clears it at 900px tall puts a device straight through the note at 657:
     58% of 591 is 343, and the copy still ends at 470. A constant offset
     clears it at every height and simply bleeds more when there is less room,
     which is the correct behaviour. */
  .dev-tablet {
    left: 27%;
    /* Carries margin for the transform. getBoundingClientRect reports the
       TRANSFORMED box, and perspective-origin is a percentage of the rig, so
       how far the tilt lifts a device varies with the hero's height: the same
       CSS top measured 7px high at 900 and 23px high at 789. The offset is set
       past the copy by more than that swing. */
    top: 29rem;
    z-index: 2;
    transform: translateZ(-70px) rotateY(var(--ry)) rotateX(var(--rx));
    animation-delay: 220ms;
  }

  .dev-phone {
    left: 6%;
    top: 31.5rem;
    z-index: 3;
    transform: rotateY(var(--ry)) rotateX(var(--rx));
    animation-delay: 320ms;
  }

  /* ── The key ──────────────────────────────────────────────────────────── */

  .portal-key {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--space-2) var(--space-3);
    flex-wrap: wrap;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-info-dark);
  }
  .portal-key li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .portal-key li::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ── Collapsed ────────────────────────────────────────────────────────────
     Below 1000 the lineup cannot hold three whole devices without shrinking
     them, and a 1240px console at 0.3x is the unreadability this hero exists
     to remove. The phone takes the composition, and the other two consoles
     keep their claim in the key instead.

     The two hidden captures are `loading="lazy"`, and a lazy image inside a
     display:none subtree is never fetched, so a phone on mobile data pays
     nothing for the devices it does not see. */
  @media (max-width: 999px) {
    /* Both ends drop below the copy. On the desktop composition the copy holds
       a narrow left column, so the crease can rake steeply and pass behind the
       lineup on the right. Collapsed, the copy is full width and there is no
       steep line that clears it at both edges: at 97/40 the right end landed
       at 40% of the hero, which is the middle of the lede. It runs shallow and
       low here instead, behind the phone. */
    .hero {
      --fold-left: 86%;
      --fold-right: 74%;
    }

    .dev-monitor,
    .dev-tablet {
      display: none;
    }

    .rig {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
      width: 100%;
      height: auto;
      z-index: 0;
      perspective: none;
      margin-top: var(--space-4);
    }

    .dev-phone {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      justify-self: center;
      margin-inline: auto;
      width: max-content;
    }

    .hero {
      /* The phone is carrying the dirección console here, so the rim is that
         portal's rather than the estudiante one it wears in the lineup. */

      /* A DEPICTION OF A PHONE, NOT A PHONE.
       *
       * This used to be min(390px, 100vw - 2rem), which is the capture's own
       * width — the rule everywhere else on the site. On a phone that made the
       * device 821px tall at 390 and 892px at 430, so the one element carrying
       * the product started 558px down the page and ran 535px past the fold,
       * and the hero came to 1354px on an 844px screen. A life-size phone
       * rendered inside a phone can only ever eat the whole screen: 390 x 2.205
       * is 860px before the bezel, and there is no arrangement of copy that
       * leaves room for it.
       *
       * So the screen is displayed BELOW the width it was shot at here, which
       * the screenshot rule forbids everywhere else. Three things make it the
       * right call on this one surface, and CLAUDE.md now records them:
       *
       *   - The rule protects a console the reader is meant to READ. This is a
       *     product shot taken in at a glance; the reader who wants to read it
       *     has a "Ver la demo" button two inches above it.
       *   - The mobile pass is shot at 3x, so a 260px display is a 4.5x source.
       *     That is a clean downsample, not the upscaling the rule was written
       *     after — the failure was a 1x/2x ladder under a 300px frame, which
       *     is a different defect that ConsoleShot's ladder already fixes.
       *   - Life-size and non-dominating are not both available at 390px wide.
       *
       * 2.267 turns a height budget back into a width: the capture's aspect is
       * 2580/1170 = 2.205, and the bezel adds 2 x 0.0308 of the screen on top
       * of it (base.css scales the hardware with the screen now). The svh term
       * is a ceiling rather than the driver: the width clamp wins on a normal
       * phone, and the height cap only bites on a short one, where it shrinks
       * the device instead of letting it run off the screen. */
      --phone-w: min(clamp(200px, 58vw, 280px), calc(68svh / 2.267));
    }
    .dev-phone :global(.device) {
      --accent: var(--accent-direccion);
    }

    .hero-inner {
      padding-top: var(--space-3);
      gap: var(--space-3);
    }
    .hero-copy {
      width: 100%;
    }
    .hero h1 {
      font-size: clamp(1.85rem, 6.6vw, 2.4rem);
      max-width: 16ch;
    }
    .hero .lede {
      max-width: 40ch;
    }

    .portal-key {
      display: flex;
    }

    /* Side by side rather than one per row. base.css sends these full-bleed
       below 1000, which costs about 60px, and on a 375 viewport that is the
       difference between seeing the console and not. */
    .hero .cta-row {
      flex-wrap: nowrap;
    }
    .hero .cta-row .btn {
      flex: 1 1 0;
      text-align: center;
      padding-inline: var(--space-2);
      white-space: nowrap;
      font-size: 0.88rem;
    }
  }

  /* Short laptops. The lineup is anchored below a copy stack that does not
     shrink with the window, so on a 657px-tall viewport the devices start at
     480px into a 591px hero and show a stripe each. The copy tightens instead,
     and the lineup moves up with it. This is the viewport that decides whether
     the composition works, not the roomy one. */
  @media (min-width: 1000px) and (max-height: 780px) {
    /* The lineup sits higher here, so its floor comes down with it — and it
       carried the same 149px of stale slack the roomy floor did, for the same
       reason. The phone ends at 1228 on a 1280x760 window; 76rem (1216) leaves
       it the same ~50px margin. */
    .hero {
      min-height: max(calc(100svh - var(--header-h)), 76rem);
    }
    .hero-inner {
      padding-block: var(--space-3);
    }
    .hero-copy {
      gap: var(--space-1);
    }
    .hero h1 {
      font-size: 2.1rem;
    }
    .hero .lede {
      font-size: 0.98rem;
    }
    .hero .note {
      display: none;
    }
    .dev-tablet {
      top: 22rem;
    }
    .dev-phone {
      top: 24.5rem;
    }
  }

  /* Short phones. At full size the copy leaves barely a stripe of the console,
     which is not a product shot. Everything tightens and the disclaimer drops:
     on the smallest screen the reader gets the product instead, and the line
     comes back on any phone taller than 720. */
  @media (max-width: 999px) and (max-height: 720px) {
    .hero h1 {
      font-size: 1.72rem;
    }
    .hero .lede {
      font-size: 0.96rem;
    }
    .hero .note {
      display: none;
    }
    /* The grid gap already separates the key from the device; the rig's own
       margin on top of it costs 25px of console on the screen with the least
       of it to spare. */
    .rig {
      margin-top: 0;
    }
    .portal-key {
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .dev {
      animation: none;
    }
    .dev {
      transition: none;
    }
  }
</style>

<script>
  // Pointer parallax on the lineup.
  //
  // It writes two custom properties on the hero rather than a transform on
  // each device: they differ in translateZ, so rewriting whole transform
  // strings from here would mean this script owning geometry that belongs in
  // the stylesheet.
  //
  // Fine pointers only. On a touchscreen there is no hover state to respond
  // to, so it would simply never move.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const hero = document.querySelector<HTMLElement>("[data-tilt]");
  const fine = matchMedia("(pointer: fine)");

  if (hero && fine.matches && !reduced.matches) {
    let frame = 0;

    const move = (ev: PointerEvent) => {
      if (frame) return; // coalesce to one write per animation frame
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (innerWidth < 1000) return; // the collapsed layout owns the transform
        const r = hero.getBoundingClientRect();
        // −0.5…0.5 from the hero's own centre.
        const px = (ev.clientX - r.left) / r.width - 0.5;
        const py = (ev.clientY - r.top) / r.height - 0.5;
        // Clamped to stay negative. A positive rotateY would swing the near
        // edge of a device toward the viewer and start magnifying it, which is
        // the one thing that visibly softens a screenshot.
        hero.style.setProperty("--ry", `${-8 + px * 4}deg`);
        hero.style.setProperty("--rx", `${3 - py * 3}deg`);
      });
    };

    const reset = () => {
      hero.style.removeProperty("--ry");
      hero.style.removeProperty("--rx");
    };

    addEventListener("pointermove", move, { passive: true });
    hero.addEventListener("pointerleave", reset);
  }
</script>
