---
import HeroShot from "../HeroShot.astro";
import ThemedShot from "../ThemedShot.astro";
import { DEMO_URL } from "../../config";

import adminStats from "../../assets/screenshots/admin-stats.png";
import adminStatsDark from "../../assets/screenshots/admin-stats-dark.png";
import gradebook from "../../assets/screenshots/gradebook-rows.png";
import gradebookDark from "../../assets/screenshots/gradebook-rows-dark.png";
import gradebookM from "../../assets/screenshots/gradebook-rows-mobile.png";
import gradebookMDark from "../../assets/screenshots/gradebook-rows-mobile-dark.png";
---

<section class="hero">
  <!-- The fold.
       The brand mark is a crimson ribbon folded back on itself, with the
       darker crimson on the underside of each fold. This is that shape at page
       scale: two surfaces meeting along a diagonal crease, the upper one lit,
       the lower one turned away, and the crease catching brand light where it
       breaks. Decorative, so aria-hidden and pointer-events:none.

       All of it is clip-path and gradients. No image, no WebGL, nothing that
       costs a slow Android anything to paint, which matters because the
       primary channel is a WhatsApp forward opened on mobile data. -->
  <div class="fold" aria-hidden="true">
    <span class="face face-up"></span>
    <span class="face face-down"></span>
    <span class="crease"></span>
    <span class="rule"></span>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Hecho para Costa Rica</p>
      <h1>El sistema con el que su colegio lleva el curso lectivo.</h1>
      <p class="lede">
        Notas, asistencia, horarios y expedientes en un solo lugar: para la
        dirección, para los docentes y para los estudiantes.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={DEMO_URL}>Ver la demo</a>
        <a class="btn btn-quiet" href="/piloto">Conocer el piloto 2027</a>
      </div>
      <p class="note">
        Es un colegio de ejemplo, con datos de ejemplo. Nada de lo que haga ahí
        se guarda.
      </p>
    </div>

    <!-- Fragments, not frames.
         The old hero put a whole 1440px console into a 609px column: a 0.42x
         downscale, which put a 14px table row at 5.9px and is why none of it
         could be read. These are crops sized so that displayed width is half
         the source width, i.e. 1:1 with the app's own CSS pixels. The
         decoration is held around them rather than over them, so nothing here
         is ever blurred by the thing meant to make it look good. -->
    <div class="stage" data-tilt>
      <figure class="frag frag-main">
        <HeroShot
          light={gradebook}
          dark={gradebookDark}
          mobileLight={gradebookM}
          mobileDark={gradebookMDark}
          alt="Libro de notas de Matemáticas, Undécimo Sección 1: cada estudiante con su nota del II Periodo."
          displayWidth={640}
          mobileDisplayWidth={358}
        />
      </figure>

      <figure class="frag frag-side">
        <ThemedShot
          light={adminStats}
          dark={adminStatsDark}
          alt="Resumen de la consola de dirección: matrícula total 90, 8 docentes, 6 de 10 aulas en uso."
          widths={[270, 540]}
          sizes="270px"
          loading="eager"
          priority={true}
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-6) var(--space-7);
    overflow: hidden;
  }

  /* ── The fold ───────────────────────────────────────────────────────── */

  .fold {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .face {
    position: absolute;
    inset: 0;
  }

  /* Upper surface: turned toward the light, so it carries the tint. The
     percentages of the two clip-paths are shared, which is what makes the two
     faces meet exactly instead of leaving a seam. */
  /* The crease runs from 90% on the left to 54% on the right, which keeps it
     clear of the copy block entirely and lets it pass behind the fragments
     instead. An earlier pass ran it at 76%/44% and it cut straight through the
     CTA row, where it read as a stray line rather than an edge. */
  .face-up {
    background: linear-gradient(
      152deg,
      color-mix(in srgb, var(--color-primary) 16%, var(--color-background)) 0%,
      color-mix(in srgb, var(--color-primary-accent) 10%, var(--color-background))
        42%,
      color-mix(in srgb, var(--color-primary) 5%, var(--color-background)) 82%
    );
    clip-path: polygon(0 0, 100% 0, 100% 54%, 0 90%);
  }

  /* Lower surface: the underside, turned away. Left at the flat page colour so
     the step across the crease is the whole effect. */
  .face-down {
    background: var(--color-background);
    clip-path: polygon(0 90%, 100% 54%, 100% 100%, 0 100%);
  }

  /* Where the sheet breaks. Crimson at the left, cooling into the product's
     periwinkle as it runs right, and fading out at both ends so it never
     terminates on a hard edge. This is the only place the brand colour appears
     outside the wordmark. */
  .crease {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      92deg,
      transparent 0%,
      var(--color-brand) 24%,
      var(--color-primary-accent) 58%,
      var(--color-primary) 80%,
      transparent 100%
    );
    opacity: 0.55;
    clip-path: polygon(0 89.7%, 100% 53.7%, 100% 54.3%, 0 90.3%);
  }

  /* A wider, much fainter wash just under the crease, so the light looks like
     it falls off the edge instead of stopping at it. */
  .rule {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      92deg,
      transparent,
      color-mix(in srgb, var(--color-primary) 38%, transparent) 60%,
      transparent
    );
    opacity: 0.45;
    filter: blur(26px);
    clip-path: polygon(0 88%, 100% 52%, 100% 60%, 0 96%);
  }

  /* ── Layout ─────────────────────────────────────────────────────────── */

  .hero-grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero-copy {
    /* Entrance, not a scroll reveal: this is above the fold on every screen,
       so a scroll sweep would fire immediately anyway. */
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .hero h1 {
    max-width: 15ch;
  }
  .hero .note {
    max-width: 42ch;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
  }

  /* ── The fragments ──────────────────────────────────────────────────── */

  /* The two fragments stack and do not overlap.
     They used to, and the stat card landed squarely on the ESTUDIANTE column,
     so the gradebook showed five grades attached to nobody. Anything that
     hides the fragment's content undoes the reason for cropping it in the
     first place. Depth comes from the tilt and the shadows instead. */
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    animation: rise var(--dur-slow) 120ms var(--ease-out) both;
  }

  .frag {
    margin: 0;
    border-radius: var(--border-radius-2);
    overflow: hidden;
    background: var(--color-white);
    box-shadow: var(--elev-3);
    outline: 1px solid var(--color-light);
  }
  .frag :global(picture),
  .frag :global(img) {
    display: block;
  }
  .frag :global(img) {
    width: 100%;
    height: auto;
  }

  .frag-main {
    max-width: 640px;
    width: 100%;
  }

  /* Second plane, stepped down and to the left so the pair reads as depth
     without either one covering the other. */
  .frag-side {
    width: 270px;
    align-self: flex-start;
    margin-top: var(--space-2);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1000px) {
    /* Wider than the 1180px the rest of the page uses. The fragment has a
       fixed 640px it cannot go below without becoming unreadable again, and at
       1180px that leaves the copy column at 385px, which breaks the h1 across
       five lines. The hero is the one section allowed to run wide. */
    .hero .wrap {
      max-width: 1280px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .stage {
      /* Bleeds toward the viewport edge, so the fragments read as a window
         onto something larger than the column holding them. */
      margin-right: calc(var(--space-4) * -1);
    }
    .frag-main {
      transform: perspective(1800px) rotateY(-7deg) rotateX(2.5deg);
      transform-origin: right center;
      transition: transform var(--dur-slow) var(--ease-out);
    }
    .frag-side {
      /* Pulled left of the main plane so the two edges do not line up, which
         is what makes them read as two sheets rather than one column. */
      margin-left: calc(var(--space-5) * -1);
      transform: perspective(1800px) rotateY(-7deg) rotateX(2.5deg);
      transform-origin: left center;
      transition: transform var(--dur-slow) var(--ease-out);
    }
  }

  /* Below the two-column breakpoint the fragments stack. The tilt goes: a
     sheared table at 360px is exactly the unreadability this hero exists to
     fix, and the side plane would cover the main one. */
  @media (max-width: 999px) {
    .frag-main {
      max-width: 100%;
    }
    .frag-side {
      width: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .stage {
      animation: none;
    }
    .frag-main,
    .frag-side {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Pointer parallax on the fragments. Fine pointers only: on a touchscreen
  // there is no hover state to respond to, so they would simply never move.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const stage = document.querySelector<HTMLElement>("[data-tilt]");
  const fine = matchMedia("(pointer: fine)");

  if (stage && fine.matches && !reduced.matches) {
    const planes = [...stage.querySelectorAll<HTMLElement>(".frag")];
    let frame = 0;

    const move = (ev: PointerEvent) => {
      if (frame) return; // coalesce to one write per animation frame
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (innerWidth < 1000) return; // the flat layout owns the transform
        const r = stage.getBoundingClientRect();
        // −0.5…0.5 from the stage's own centre.
        const px = (ev.clientX - r.left) / r.width - 0.5;
        const py = (ev.clientY - r.top) / r.height - 0.5;
        const ry = -7 + px * 4;
        const rx = 2.5 - py * 3;
        for (const p of planes) {
          p.style.transform = `perspective(1800px) rotateY(${ry}deg) rotateX(${rx}deg)`;
        }
      });
    };

    const reset = () => {
      for (const p of planes) p.style.transform = "";
    };

    addEventListener("pointermove", move, { passive: true });
    stage.addEventListener("pointerleave", reset);
  }
</script>
