---
import { NAV, PRIVACY_URL, TERMS_URL } from "../config";

// Lives at layout level rather than inside a page's <main>, where it used to
// sit. A footer is not part of the document's main content, and at five routes
// it would otherwise be pasted five times.
---

<footer class="footer">
  <div class="wrap footer-inner">
    <nav class="footer-nav" aria-label="Pie de página">
      <ul>
        <li><a href="/">Inicio</a></li>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-legal">
      <p class="footer-brand">
        <span class="fb-1">SIMPLE</span> <span class="fb-2">MANAGE PRO</span>
      </p>
      <p>
        Costa Rica
        <span aria-hidden="true"> · </span>
        <a href={PRIVACY_URL}>Política de privacidad</a>
        <span aria-hidden="true"> · </span>
        <a href={TERMS_URL}>Términos del servicio</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-light);
    font-size: 0.9rem;
    color: var(--color-info-dark);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-4);
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* Row gap is small because the anchors carry their own vertical padding
       below; without that split the padded rows sat 45px apart. */
    gap: var(--space-1) var(--space-3);
  }

  /* A tap target, not a run of text. This is the only navigation at the foot
     of a page that is 9,400px tall on a phone, and at its natural line box it
     was 20px high — under half of the 44px a thumb needs. The padding is
     vertical only, so the row still reads as a line of links rather than as a
     stack of buttons. */
  .footer-nav a {
    display: inline-block;
    padding-block: 0.75rem;
    color: var(--color-dark-variant);
    text-decoration: none;
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: var(--color-primary-text);
    text-decoration: underline;
  }

  .footer-brand {
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-1);
  }

  .fb-1 {
    color: var(--color-dark);
  }

  .fb-2 {
    color: var(--color-brand);
  }

  .footer-legal p + p {
    margin-top: var(--space-1);
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .footer-legal {
      text-align: right;
    }
  }
</style>
