---
const DEMO_URL = "https://demo.simplemanagepro.com";

// Four anchors, so no hamburger: below 900px the list is simply dropped and
// the header keeps the mark, the theme control and the demo. A one-page
// document that a visitor can reach the end of by scrolling does not need a
// menu that has to be opened before it can be read.
const nav = [
  { href: "#portales", label: "Portales" },
  { href: "#datos", label: "Datos" },
  { href: "#piloto", label: "Piloto 2027" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="#contenido" aria-label="Simple Manage Pro — inicio">
      <img src="/apple-touch-icon.png" alt="" width="30" height="30" />
      <span class="wordmark">Simple <b>Manage Pro</b></span>
    </a>

    <nav class="nav" aria-label="Secciones de la página">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar a tema oscuro"
      >
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.4v2.6M12 19v2.6M4.4 12H1.8M22.2 12h-2.6M6.3 6.3 4.5 4.5M19.5 19.5l-1.8-1.8M17.7 6.3l1.8-1.8M4.5 19.5l1.8-1.8"
          ></path>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.4A8.6 8.6 0 1 1 9.6 3.5a7 7 0 0 0 10.9 10.9Z"></path>
        </svg>
      </button>

      <a class="header-cta" href={DEMO_URL}>Ver la demo</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    /* The blur is the whole reason the header can be translucent over a
       moving gradient without the text sitting on noise. Where it is
       unsupported the color-mix above still leaves an 82% opaque bar. */
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-mid) var(--ease-out);
  }
  /* Set by the scroll listener rather than always-on: at the top of the page
     the header should dissolve into the hero, not sit on a rule. */
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-light);
  }

  .bar {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 0.7rem var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-dark);
    flex-shrink: 0;
  }
  .brand img {
    border-radius: var(--border-radius-1);
  }
  .wordmark {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .wordmark b {
    font-weight: 700;
    color: var(--color-brand);
  }

  .nav {
    margin-inline: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    color: var(--color-dark-variant);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nav a:hover {
    color: var(--color-dark);
    border-bottom-color: var(--color-primary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--color-light);
    border-radius: var(--border-radius-2);
    background: transparent;
    color: var(--color-dark-variant);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    background: var(--color-white);
    color: var(--color-dark);
  }
  .theme-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  /* The icon shows the DESTINATION, not the current state, so that it agrees
     with the button's own label: in light mode the label reads "Cambiar a
     tema oscuro" and the glyph is a moon. A lone icon button is read as the
     action it performs, and icon and label disagreeing is worse than either
     convention on its own. */
  .i-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-moon {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .i-sun {
      display: block;
    }
  }

  .header-cta {
    display: inline-block;
    padding: 0.55rem 1.05rem;
    border-radius: var(--border-radius-2);
    background: var(--color-primary-fill);
    color: #fff;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .header-cta:hover {
    transform: translateY(-1px);
    box-shadow: var(--elev-2);
  }

  @media (max-width: 899px) {
    .nav {
      display: none;
    }
  }
  /* The product name is the first impression for someone opening a forwarded
     WhatsApp link, so it survives as far down as it fits — tightened rather
     than dropped. Below 360px the row genuinely runs out of room and the mark
     alone carries it. */
  @media (max-width: 560px) {
    .bar {
      gap: var(--space-2);
      padding-inline: var(--space-2);
    }
    .wordmark {
      font-size: 0.92rem;
    }
    .header-cta {
      padding: 0.55rem 0.85rem;
    }
  }
  @media (max-width: 359px) {
    .wordmark {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const header = document.querySelector<HTMLElement>(".site-header");

  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

  // Three states, not two: no stored value means "follow the OS", which is
  // what a first visitor gets. Reading the resolved value rather than the
  // stored one is what makes the first click always do the visible thing.
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === "dark" : prefersDark.matches;

  const label = () => {
    if (!btn) return;
    btn.setAttribute(
      "aria-label",
      isDark() ? "Cambiar a tema claro" : "Cambiar a tema oscuro",
    );
  };

  // <picture> resolves `media` against the OS preference and has no idea the
  // page carries its own toggle, so an explicit choice has to rewrite the
  // query itself. "not all" never matches, "all" always does — which is how
  // the screenshots follow the toggle instead of the operating system.
  // Only the dark source is touched; the light one is the fallback either way.
  const syncShots = () => {
    const dark = isDark();
    document
      .querySelectorAll<HTMLSourceElement>("[data-dark-source]")
      .forEach((s) => {
        s.media = dark ? "all" : "not all";
      });
  };

  btn?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("smp-landing-theme", next);
    } catch (e) {
      /* private mode — the toggle still works for this page view */
    }
    label();
    syncShots();
  });

  // Keep the label honest if the OS flips while the page is open and the
  // visitor never made an explicit choice. The screenshots need no help in
  // that case — their media query is still the live OS one.
  prefersDark.addEventListener("change", () => {
    if (!root.dataset.theme) label();
  });

  label();
  // Only if a stored choice already overrode the OS before first paint.
  if (root.dataset.theme) syncShots();

  if (header) {
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute("data-scrolled", "");
      else header.removeAttribute("data-scrolled");
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
