---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Every product screenshot on the site goes through here.
 *
 * It exists to make one rule impossible to forget, because breaking it is what
 * made the previous pass look soft:
 *
 *     ship srcset candidates up to the highest pixel density the frame will
 *     actually be displayed on, and never above the source's own width.
 *
 * Then every display gets a downsample and the densest one gets untouched
 * pixels. The old call sites passed a hand-written widths list that topped out
 * at 2400 against a 2880 source, so any 2x screen needed ~2900 device px and
 * got 2400 stretched — and an upscaled screenshot is exactly what "bad
 * quality" looks like.
 *
 * THE DENSITY IS NOT THE SAME ON BOTH AXES, and stating this rule as a flat
 * "1x and 2x" is what broke it a second time. Laptops and monitors are 1x or
 * 2x. Phones are 3x, near universally, which is exactly why `npm run capture`
 * shoots the mobile pass at 390@3x. A 1x/2x ladder under a 300px phone frame
 * topped out at 600w against a 900 device-px need, so the browser upscaled by
 * 1.5x — on the one surface where the reader is closest to the glass. Desktop
 * stays at 2x deliberately: 1240 * 3 would emit a 3720px WebP that no real
 * display asks for.
 *
 * Two axes, not one:
 *
 * - THEME, because a dark-mode visitor reading light screenshots on a dark page
 *   is the most visible way the site can contradict itself.
 * - VIEWPORT, optionally. A console captured at 1280 CSS px is 0.3x on a phone.
 *   `npm run capture` therefore shoots a 390@3x pass as well, and passing the
 *   `mobile*` pair here switches to it below `breakpoint`.
 *
 * `<picture>` takes the first source whose media matches, so the mobile pair
 * has to precede the desktop pair.
 *
 * `data-dark-source` carries the EXTRA condition that must survive the theme
 * rewrite, empty when there is none. Header.astro's syncShots() reads it: on
 * dark it sets media to that condition (or "all" when blank), on light to
 * "not all". <picture> resolves `media` against the OS preference and cannot
 * see the page's own toggle, so rewriting the query is what makes screenshots
 * follow the toggle. The light sources keep their static viewport media and are
 * what remains once the dark ones are switched off.
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  /** Phone capture. Omit to serve the desktop frame at every width. */
  mobileLight?: ImageMetadata;
  mobileDark?: ImageMetadata;
  alt: string;
  /** CSS px the desktop frame is displayed at. Drives the whole srcset. */
  displayWidth: number;
  /** CSS px the phone frame is displayed at. Default 390 because that is the
   *  viewport `npm run capture` shoots the mobile pass at, and displaying a
   *  390 CSS-px capture in a narrower box shrinks the app's own layout: at 300
   *  the product's 13px UI text painted at 10px before any resampling.
   *
   *  ONE SURFACE IS ALLOWED TO BREAK THAT, and it passes 280: the home hero's
   *  phone, which is a product shot rather than a console anyone reads — a
   *  life-size phone inside a phone is 860px of screen before the bezel and
   *  eats the whole viewport. The mobile pass is shot at 3x, so 280 is still a
   *  4.2x source and a clean downsample. Everywhere else, keep this equal to
   *  the capture viewport. CLAUDE.md carries the full argument. */
  mobileDisplayWidth?: number;
  /** Override when the frame is fluid below its cap, e.g.
   *  "(min-width: 1292px) 1240px, calc(100vw - 3.2rem)". `displayWidth` still
   *  sets the candidates; this only tells the browser which one to pick. */
  sizes?: string;
  mobileSizes?: string;
  breakpoint?: number;
  loading?: "eager" | "lazy";
  priority?: boolean;
  class?: string;
}

const {
  light,
  dark,
  mobileLight,
  mobileDark,
  alt,
  displayWidth,
  mobileDisplayWidth = 390,
  sizes,
  mobileSizes: mobileSizesProp,
  breakpoint = 760,
  loading = "lazy",
  priority = false,
  class: className,
} = Astro.props;

const desktopSizes = sizes ?? `${displayWidth}px`;
const mobileSizes = mobileSizesProp ?? `${mobileDisplayWidth}px`;

// WebP at Astro's default (~80) rings around 13px UI glyph edges, which on a
// page whose subject IS 13px UI text is the difference between crisp and not.
// 92 costs roughly a third more bytes and removes the artefacts.
const QUALITY = 92;

/** Every density up to `max`, clamped to what the capture actually contains. */
const ladder = (src: ImageMetadata, w: number, max: number) =>
  Array.from({ length: max }, (_, i) => w * (i + 1)).filter(
    (n) => n <= src.width,
  );

/** Highest density each axis is displayed at. See the docblock: this asymmetry
 *  is the point, not an oversight. */
const DESKTOP_DENSITY = 2;
const MOBILE_DENSITY = 3;

/** Intrinsic height at a given display width, so the box reserved for the
 *  image matches the one that lands in it. */
const heightAt = (src: ImageMetadata, w: number) =>
  Math.round((w * src.height) / src.width);

// `width` is passed as well as `widths`. Without it Astro resolves the
// fallback `src` at the capture's natural size, which emitted a 3840px WebP
// per shot that no browser ever requests — every <source> here has a matching
// media condition, so the <img> is a fallback in name only. Six of those is
// about a megabyte of dead weight in the deploy.
const shot = (src: ImageMetadata, w: number, s: string, density: number) =>
  getImage({
    src,
    widths: ladder(src, w, density),
    width: w,
    height: heightAt(src, w),
    sizes: s,
    format: "webp",
    quality: QUALITY,
  });

const hasMobile = Boolean(mobileLight && mobileDark);

const [d1, d2, m1, m2] = await Promise.all([
  shot(light, displayWidth, desktopSizes, DESKTOP_DENSITY),
  shot(dark, displayWidth, desktopSizes, DESKTOP_DENSITY),
  mobileLight
    ? shot(mobileLight, mobileDisplayWidth, mobileSizes, MOBILE_DENSITY)
    : null,
  mobileDark
    ? shot(mobileDark, mobileDisplayWidth, mobileSizes, MOBILE_DENSITY)
    : null,
]);

const narrow = `(max-width: ${breakpoint - 1}px)`;

// Reserved box, per source rather than once on the <img>.
//
// A phone capture is 0.45 wide-to-tall and the desktop one is 16:9, so the
// single <img width/height> pair — which can only describe one of them — was
// reserving a 16:9 box below the breakpoint and then reflowing the whole hero
// by ~490px when the real image decoded. `width`/`height` on a <source> is how
// <picture> is meant to carry a per-source aspect ratio, and every current
// browser honours it.
const desktopBox = { width: displayWidth, height: heightAt(light, displayWidth) };
const mobileBox = mobileLight
  ? {
      width: mobileDisplayWidth,
      height: heightAt(mobileLight, mobileDisplayWidth),
    }
  : desktopBox;
---

<picture class={className}>
  {
    hasMobile && (
      <>
        <source
          data-dark-source={narrow}
          srcset={m2!.srcSet.attribute}
          sizes={mobileSizes}
          type="image/webp"
          media={`${narrow} and (prefers-color-scheme: dark)`}
          width={mobileBox.width}
          height={mobileBox.height}
        />
        <source
          srcset={m1!.srcSet.attribute}
          sizes={mobileSizes}
          type="image/webp"
          media={narrow}
          width={mobileBox.width}
          height={mobileBox.height}
        />
      </>
    )
  }
  <source
    data-dark-source=""
    srcset={d2.srcSet.attribute}
    sizes={desktopSizes}
    type="image/webp"
    media="(prefers-color-scheme: dark)"
    width={desktopBox.width}
    height={desktopBox.height}
  />
  <source
    srcset={d1.srcSet.attribute}
    sizes={desktopSizes}
    type="image/webp"
    width={desktopBox.width}
    height={desktopBox.height}
  />
  <img
    src={d1.src}
    alt={alt}
    width={desktopBox.width}
    height={desktopBox.height}
    loading={loading}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : "auto"}
  />
</picture>
