---
import "../styles/tokens.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The OG card is a first-class deliverable, not metadata: directors forward
// this link in WhatsApp, which renders a preview, so the card is the first
// impression for a second reader who never spoke to Gabriel. See BRIEF §8.
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="Simple Manage Pro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Set before first paint so a returning visitor never sees a flash of
      // the other theme.
      try {
        const saved = localStorage.getItem("smp-landing-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
