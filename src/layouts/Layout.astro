---
import "../styles/tokens.css";
import "../styles/base.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME } from "../config";

interface Props {
  /** Keyword-led and page-specific. The brand is appended, so leave it out. */
  title: string;
  description: string;
  /** Absolute-from-root path, e.g. "/og-piloto.png". Defaults to the home card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Set false when the title already ends in the brand. */
  brandInTitle?: boolean;
}

const {
  title,
  description,
  ogImage = "/og.png",
  ogImageAlt = "Simple Manage Pro, el sistema con el que su colegio lleva el curso lectivo.",
  ogType = "website",
  brandInTitle = true,
} = Astro.props;

const fullTitle = brandInTitle ? `${title} | ${SITE_NAME}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The OG card is a first-class deliverable, not metadata: directors forward
// this link in WhatsApp, which renders a preview, so the card is the first
// impression for a second reader who never spoke to Gabriel. See BRIEF §8.
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* The app's own icon set, copied rather than relinked: the landing page
        is a separate Vercel project on the apex domain, so it cannot reach
        the demo subdomain's /public.

        The 48, 96 and 192 PNGs are linked as icons here, not left to the
        manifest alone. Google wants a Search favicon that is a square multiple
        of 48px and ignores the manifest when choosing one, so without these
        lines its only rel="icon" candidates top out at 32 (the .ico) and it
        falls back to the apple-touch-icon. 48 and 96 give it a clean direct
        match so it never has to downscale the 192 heavily; all three derive
        from the 512px source. Ordered small to large. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f6f6f9"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#181a1e"
    />

    {/* Only the weights that render above the fold. 800 is the display head,
        700 the wordmark, 600 the nav and eyebrows, 400 the lede. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-700-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-800-normal.woff2"
      crossorigin
    />

    {/* Set before first paint so a returning visitor never sees a flash of
        the other theme. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("smp-landing-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>

    {/* Prefetch the next route on hover/pointerdown so a director clicking
        through the site never waits on a fresh document. Same-origin only:
        "/*" never matches the demo/legal origins, which must not be
        prefetched. A pure hint, ignored where unsupported and inert with
        JavaScript disabled, so the no-JS render is unaffected. */}
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          { "where": { "href_matches": "/*" }, "eagerness": "moderate" }
        ]
      }
    </script>

    {/* Per-page structured data and any other head extras. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    {/* Vercel Web Analytics and Speed Insights. Both are cookie-free, so there
        is no consent banner and nothing to explain under Ley 8968 (BRIEF §9).
        Speed Insights adds real-user Core Web Vitals, which matter here because
        the primary channel is a WhatsApp forward opening on mobile data.

        Deliberately here and not in <head>, where Vercel's docs put them. Each
        component renders a real custom element (<vercel-analytics>,
        <vercel-speed-insights>), and an unknown element in <head> ends head
        parsing: everything below it, including the theme script and the JSON-LD
        slot, would be reparented into <body> and the theme script would then
        run after first paint, which is the flash it exists to prevent. */}
    <Analytics />
    <SpeedInsights />

    <script>
      // Progressive enhancement in the literal sense: the reveal styles are
      // gated behind .js, so this class going on is what arms them. Without JS
      // every page renders complete and static.
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");

      if (!reduced.matches) {
        document.documentElement.classList.add("js");

        // Deliberately a scroll sweep rather than an IntersectionObserver.
        //
        // IO only reports at the moments an element CROSSES its threshold.
        // Miss that window — a fling scroll on a phone, a jumped scroll
        // position, a background tab throttling frames — and the element is
        // never reported again, so a section that is opacity:0 until told
        // otherwise stays invisible for the rest of the visit. That is exactly
        // what happened to the "Hoy / Con Simple Manage Pro" block under a
        // 400px-per-tick scroll, and losing a whole section of the argument is
        // far worse than losing an animation.
        //
        // Re-testing position on every scroll cannot miss: it asks "is it in
        // view NOW", not "did it cross just now". The list only shrinks, and
        // the listener detaches once it empties.
        let pending = [...document.querySelectorAll<HTMLElement>(".reveal")];
        let queued = false;

        const sweep = () => {
          queued = false;
          const limit = innerHeight * 0.92; // reveal just before fully in view
          pending = pending.filter((el) => {
            if (el.getBoundingClientRect().top > limit) return true;
            el.classList.add("is-in");
            return false;
          });
          if (!pending.length) removeEventListener("scroll", onScroll);
        };

        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };

        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll, { passive: true });
        sweep();
      }
    </script>

    <style>
      /* Visible only on keyboard focus. Placed before the sticky header in
         the DOM so it is the first stop, and given a z-index above it so it
         is not painted underneath. */
      .skip {
        position: fixed;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 100;
        padding: 0.7rem 1.1rem;
        border-radius: var(--border-radius-2);
        background: var(--color-white);
        color: var(--color-dark);
        font-weight: 600;
        text-decoration: none;
        box-shadow: var(--elev-2);
        transform: translateY(calc(-100% - var(--space-3)));
        transition: transform var(--dur-fast) var(--ease-out);
      }
      .skip:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
