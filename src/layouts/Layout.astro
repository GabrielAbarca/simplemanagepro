---
import "../styles/tokens.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The OG card is a first-class deliverable, not metadata: directors forward
// this link in WhatsApp, which renders a preview, so the card is the first
// impression for a second reader who never spoke to Gabriel. See BRIEF §8.
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="Simple Manage Pro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Simple Manage Pro — el sistema con el que su colegio lleva el curso lectivo." />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The app's own icon set, copied rather than relinked: the landing page
         is a separate Vercel project on the apex domain, so it cannot reach
         the demo subdomain's /public. The previous /favicon.svg never existed
         in either repo — the app has no SVG mark, only this raster set. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f6f6f9"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#181a1e"
    />

    <!-- Only the three weights that render above the fold. 700 is the h1,
         600 the nav and eyebrows, 400 the lede. 500/800 load normally. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-600-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/poppins-latin-700-normal.woff2"
      crossorigin
    />

    <script is:inline>
      // Set before first paint so a returning visitor never sees a flash of
      // the other theme.
      try {
        const saved = localStorage.getItem("smp-landing-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <slot />

    <style>
      /* Visible only on keyboard focus. Placed before the sticky header in
         the DOM so it is the first stop, and given a z-index above it so it
         is not painted underneath. */
      .skip {
        position: fixed;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 100;
        padding: 0.7rem 1.1rem;
        border-radius: var(--border-radius-2);
        background: var(--color-white);
        color: var(--color-dark);
        font-weight: 600;
        text-decoration: none;
        box-shadow: var(--elev-2);
        transform: translateY(calc(-100% - var(--space-3)));
        transition: transform var(--dur-fast) var(--ease-out);
      }
      .skip:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
