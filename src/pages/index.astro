---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Problema from "../components/sections/Problema.astro";
import PortalesResumen from "../components/sections/PortalesResumen.astro";
import Datos from "../components/sections/Datos.astro";
import PilotoResumen from "../components/sections/PilotoResumen.astro";
import CierreCta from "../components/sections/CierreCta.astro";
import { DEMO_URL, EMAIL, SITE_NAME } from "../config";

const site = Astro.site?.origin ?? "https://simplemanagepro.com";

// Organization and SoftwareApplication together: the first is what the brand
// is, the second is what the page is about. WebSite carries the name a search
// result renders above the URL.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: SITE_NAME,
      url: site,
      logo: `${site}/android-chrome-512x512.png`,
      email: EMAIL,
      areaServed: { "@type": "Country", name: "Costa Rica" },
      founder: { "@type": "Person", name: "Gabriel Zelaya" },
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: SITE_NAME,
      inLanguage: "es-CR",
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      inLanguage: "es",
      url: site,
      publisher: { "@id": `${site}/#organization` },
      description:
        "Sistema de gestión escolar para colegios de Costa Rica: notas, asistencia, horarios, documentos externos, con consolas separadas para la dirección, los docentes y los estudiantes.",
      featureList: [
        "Curso lectivo y periodos",
        "Niveles, secciones y aulas",
        "Importación de documentos desde Excel",
        "Libro de notas con categorías ponderadas",
        "Asistencia por sección",
        "Informe de progreso imprimible",
        "Portal del estudiante",
      ],
      softwareHelp: DEMO_URL,
    },
  ],
};
---

<Layout
  title="Sistema de gestión escolar en Costa Rica"
  description="Notas, asistencia, horarios y expedientes de su colegio en un solo sistema, para la dirección, los docentes y los estudiantes. Piloto 2027 para tres colegios."
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <Hero />
  <Problema />
  <PortalesResumen />
  <Datos />
  <PilotoResumen />
  <CierreCta />
</Layout>
