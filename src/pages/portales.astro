---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PortalGlyph from "../components/PortalGlyph.astro";
import ConsoleShot from "../components/ConsoleShot.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import CierreCta from "../components/sections/CierreCta.astro";
import { portals } from "../data/site";
import { breadcrumbLd } from "../lib/schema";
import { DEMO_URL } from "../config";
---

<Layout
  title="Libro de notas, asistencia y matrícula"
  description="Una consola para la dirección, una para cada docente y un portal para el estudiante. Notas, asistencia, horarios y matrícula sobre la misma información."
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbLd("Portales", "/portales"))}
  />

  <PageHero
    eyebrow="Nuestro producto"
    title="Tres portales, un solo sistema"
    lede="La dirección configura el colegio, los docentes manejan calificaciones y los estudiantes tienen accesso en tiempo real a sus notas."
  >
    <div class="cta-row">
      <a class="btn btn-primary" href={DEMO_URL}>Ver la demo</a>
    </div>
    <p class="note">
      La demo presenta un colegio de ejemplo, con datos ficticios. Nada de lo que haga
        se guarda.
    </p>

    <!-- The page's own subject as its ornament: three panels of the folded
         sheet, one per console, in the three accents the sections below carry.
         It previews the page rather than decorating it. -->
    <div class="ornament" slot="ornament" aria-hidden="true">
      {
        portals.map((p, i) => (
          <span class="panel" style={`--accent:${p.accent}; --n:${i}`}>
            <PortalGlyph variant={p.glyph} />
          </span>
        ))
      }
    </div>
  </PageHero>

  {
    portals.map((p, i) => (
      // Alternating bands, so three identically structured sections do not run
      // as one undifferentiated column. The band's own crease sits above the
      // section's content by construction, so it cannot cross type.
      <section
        class:list={["portal", "band", i % 2 === 1 && "fold-band"]}
        id={p.id}
        style={`--accent:${p.accent}`}
      >
        <div class="wrap">
          <div class="portal-head">
            <div class="portal-intro reveal">
              <p class="portal-label">{p.label}</p>
              <h2>{p.title}</h2>
              <p class="portal-body">{p.body}</p>
              {p.detail?.map((par) => (
                <p class="portal-detail" set:html={par} />
              ))}
              <ul class="portal-caps">
                {p.capabilities.map((c) => (
                  <li>
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M3 8.4 6.3 11.7 13 5" />
                    </svg>
                    {c}
                  </li>
                ))}
              </ul>
              <a class="portal-cta" href={DEMO_URL}>
                Abrir esta consola en la demo
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M2.5 8h11M9.5 3.5 14 8l-4.5 4.5" />
                </svg>
              </a>
            </div>

            {/* The same console in hardware, on a phone.
                It carries the phone capture at EVERY width now: below 760 it
                is the only console on screen, and above 1000 it is the second
                plane beside the monitor. That split is why the monitor no
                longer takes a mobile pair. */}
            <div class="portal-phone reveal">
              <DeviceFrame kind="phone" screenWidth="var(--phone-w)" accent={p.accent}>
                <ConsoleShot
                  light={p.mobileImage}
                  dark={p.mobileImageDark}
                  alt=""
                  displayWidth={390}
                  sizes="min(390px, calc(100vw - 3.2rem))"
                  loading="lazy"
                />
              </DeviceFrame>
              <p class="phone-caption">También desde el teléfono</p>
            </div>
          </div>

          {/* Desktop capture only, and display:none below 760. A lazy image in
              a display:none subtree is never fetched, so a phone stops pulling
              three 1240px consoles it is never shown. That is also why the
              mobile pair came off: one ConsoleShot serving two viewports is
              what produced the 300px frame the components both warn about. */}
          <div class="portal-shot reveal">
            <DeviceFrame kind="monitor" screenWidth="var(--shot-w)" accent={p.accent}>
              <ConsoleShot
                light={p.image}
                dark={p.imageDark}
                alt={p.alt}
                displayWidth={1240}
                sizes="(min-width: 1292px) 1240px, calc(100vw - 3.2rem)"
                loading="lazy"
              />
            </DeviceFrame>
          </div>

          {p.extraImage && p.extraImageDark && (
            <div class="portal-shot portal-shot-extra reveal">
              <DeviceFrame kind="monitor" screenWidth="var(--shot-w)" accent={p.accent}>
                <ConsoleShot
                  light={p.extraImage}
                  dark={p.extraImageDark}
                  alt={p.extraAlt ?? ""}
                  displayWidth={1240}
                  sizes="(min-width: 1292px) 1240px, calc(100vw - 3.2rem)"
                  loading="lazy"
                />
              </DeviceFrame>
              <p class="shot-caption">{p.extraAlt}</p>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <CierreCta />
</Layout>

<style>
  /* ── The hero ornament ────────────────────────────────────────────────── */

  .ornament {
    display: grid;
    aspect-ratio: 5 / 4;
  }

  .panel {
    grid-area: 1 / 1;
    align-self: start;
    width: 66%;
    padding: 0.8rem;
    background: var(--color-white);
    border: 1px solid var(--color-light);
    border-top: 3px solid var(--accent);
    border-radius: var(--border-radius-2);
    box-shadow: var(--elev-2);
    /* Stepped down and across, so three panels read as a stack of consoles
       rather than as one card with a shadow. */
    translate: calc(var(--n) * 24%) calc(var(--n) * 30%);
    rotate: calc((var(--n) - 1) * -1.6deg);
  }

  /* ── The portal sections ──────────────────────────────────────────────── */

  /* Every portal is laid out identically. A previous pass right-aligned the
     copy on even portals, which broke the pattern for no reason and pulled
     attention to the asymmetry rather than to the console being described. */
  .portal {
    padding-block: var(--space-6);
    /* The wrap runs wider here than the page default: 1240px of content is
       what puts a 1280 CSS-px capture at 1:1 with the app. */
  }
  .portal .wrap {
    max-width: 1292px;
  }

  .portal-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .portal-intro {
    max-width: var(--measure);
  }

  /* The portal's own name, not a small eyebrow. The reader has to know which
     console they are looking at before they read the claim about it, and when
     this was set at eyebrow scale the claim won every time. Filled with the
     portal's accent, which is the same hue its card wears on the home page. */
  .portal-label {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* Was clamped down to 2rem, which put it below the section heads it competes
     with elsewhere on the site. It is the claim of its section. */
  .portal h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }

  .portal-body {
    margin-top: var(--space-3);
    color: var(--color-dark-variant);
    font-size: 1.05rem;
  }

  /* The body is the section's one-line claim; these are the paragraphs that
     back it. Same muted tier as the body, a touch smaller, with the reading
     measure the intro already sets. Links inherit the global --color-primary-text,
     which is audited on this ground. */
  .portal-detail {
    margin-top: var(--space-3);
    color: var(--color-dark-variant);
    font-size: 1rem;
    line-height: 1.65;
  }

  .portal-caps {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .portal-caps li {
    display: grid;
    grid-template-columns: 1.05rem 1fr;
    gap: 0.65rem;
    align-items: start;
    color: var(--color-dark);
    font-size: 0.98rem;
  }
  .portal-caps svg {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.3rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .portal-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--space-3);
    font-weight: 600;
    text-decoration: none;
  }
  .portal-cta:hover {
    text-decoration: underline;
  }
  .portal-cta svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate var(--dur-fast) var(--ease-out);
  }
  .portal-cta:hover svg {
    translate: 0.2rem 0;
  }

  /* DeviceFrame sizes itself from its screen and does not shrink on its own,
     so the fluidity ConsoleFrame used to carry in CSS is handed to it as a
     length. These match the `sizes` on each ConsoleShot: change one and change
     the other, or the browser picks a candidate for a slot that does not
     exist. The monitor's 30px is its bezel, which sits outside the screen. */
  .portal {
    --shot-w: min(1240px, calc(100vw - 3.2rem - 30px));
    --phone-w: min(390px, calc(100vw - 3.2rem - 24px));
  }

  /* The phone is the only console below 760, so the monitor goes. Its capture
     is lazy, and a lazy image inside a display:none subtree is never fetched. */
  @media (max-width: 759px) {
    .portal-shot {
      display: none;
    }
  }

  .portal-phone {
    display: none;
  }
  /* Below 760 the phone IS the console, so it is centred and on its own. */
  @media (max-width: 759px) {
    .portal-phone {
      display: block;
    }
    .portal-phone :global(.device) {
      margin-inline: auto;
    }
  }
  /* The darker tier, not --color-info-dark. These captions sit inside the
     device's accent glow, which tints the ground under them to about #c2c6e0,
     and the muted tier only reached 4.03:1 there. This is the headroom the two
     muted tiers were darkened to create: spend it, then re-run the audit. */
  .phone-caption {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--color-dark);
    text-align: center;
  }

  .portal-shot-extra {
    margin-top: var(--space-4);
  }
  .shot-caption {
    margin-top: var(--space-3);
    font-size: 0.85rem;
    color: var(--color-dark);
    text-align: center;
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* The console arrives from the side the section reads toward. Ends at
     identity, so the resting frame is pixel-exact — a transform still applied
     at rest would resample every glyph in it. */
  .js .portal-shot.reveal {
    transform: translateY(1.4rem) translateX(1.5rem);
  }
  .js .portal-shot.reveal.is-in {
    transform: none;
  }

  @media (min-width: 1000px) {
    .portal-head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-5);
      align-items: center;
    }
    .portal-phone {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-cta:hover svg {
      translate: none;
    }
    .panel {
      rotate: none;
    }
  }
</style>
