---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PortalGlyph from "../components/PortalGlyph.astro";
import { breadcrumbLd } from "../lib/schema";
import { DEMO_URL, EMAIL, WHATSAPP_MSG, waHref } from "../config";

// The WhatsApp brand glyph, used by both the hero CTA and the channel card.
// The <svg>/<path> stay inline in the template so the scoped fill rules below
// still reach them; only the path data is shared.
const WHATSAPP_ICON =
  "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.335-1.652a11.882 11.882 0 0 0 5.71 1.454h.006c6.585 0 11.946-5.359 11.949-11.893a11.821 11.821 0 0 0-3.495-8.46";
---

<Layout
  title="Hablemos del piloto 2027"
  description="Si le interesa el piloto 2027 para su colegio, la conversación empieza por WhatsApp o por correo. Sin formularios, sin planes y sin tarjeta de crédito."
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbLd("Contacto", "/contacto"))}
  />

  <PageHero
    eyebrow="Piloto 2027"
    title="¿Está interesado en el sistema?"
    lede="Si estás interesado en conocer más sobre nuestro sistema y participar en el piloto 2027, 
      contáctanos para obtener más información y programar una demostración."
  >
    <div class="cta-row">
      <a class="btn btn-primary btn-icon" target="_blank" href={waHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={WHATSAPP_ICON}></path>
        </svg>
        WhatsApp
      </a>
      <a class="btn btn-quiet" href={`mailto:${EMAIL}`}>Escribir un correo</a>
    </div>
    <p class="note">
      No hay formulario, ni plan que escoger.
    </p>

    {/* What tapping the button actually produces. The pre-filled message is
        the whole reason WhatsApp is the primary channel, and showing it
        removes the one hesitation a director has about a chat link: not
        knowing what they are about to send. */}
    <div class="preview" slot="ornament">
      <p class="preview-title">Nos sería de utilidad conocer información básica</p>
      <div class="bubble">
        <p>{WHATSAPP_MSG}</p>
      </div>
      <p class="preview-note">Usted lo edita antes de enviarlo.</p>
    </div>
  </PageHero>

  <section class="band fold-band">
    <div class="wrap">
      {/* Ordered the way the reader should move: look at the system first,
          then write. "Antes de escribir" is not a third channel, it is the
          step before either of them, so it stops being a card of the same
          size and shape as the two that are. */}
      <div class="card-lead before reveal">
        <div class="before-copy">
          <p class="eyebrow">Antes de escribir</p>
          <h2>Vea el sistema primero.</h2>
          <p>
            La demo está abierta y no pide ningún dato. Es un colegio de
            ejemplo, con datos de ejemplo, y desde ahí se llega a las tres
            consolas.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" target="_blank" href={DEMO_URL}>Ver la demo</a>
          </div>
        </div>
        <div class="before-glyphs" aria-hidden="true">
          <span style="--accent: var(--accent-direccion)">
            <PortalGlyph variant="direccion" />
          </span>
          <span style="--accent: var(--accent-docente)">
            <PortalGlyph variant="docente" />
          </span>
          <span style="--accent: var(--accent-estudiante)">
            <PortalGlyph variant="estudiante" />
          </span>
        </div>
      </div>

      <ul class="channels reveal reveal-stagger">
        <li class="card" style="--i:0">
          <span class="ch-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2.8" y="5" width="18.4" height="14" rx="2.8"></rect>
              <path d="m3.4 7 8.6 6 8.6-6"></path>
            </svg>
          </span>
          <h2>Correo</h2>
          <p>Para cuando conviene dejar constancia escrita de lo conversado.</p>
          <a class="ch-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>

        <li class="card" style="--i:1">
          <span class="ch-icon ch-icon-brand">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={WHATSAPP_ICON}></path>
            </svg>
          </span>
          <h2>WhatsApp</h2>
          <p>
            Lo más rápido. El mensaje va prellenado y usted lo edita antes de
            enviarlo.
          </p>
          <p class="ch-phone">+506 7184-8300</p>
        </li>
      </ul>

      <div class="narrow reveal">
        <p class="aside">
          Conviene tener a mano el tamaño aproximado del colegio: cuántas
          secciones, cuántos docentes y cuántos estudiantes matriculados. Con
          eso la primera conversación ya es concreta.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── The WhatsApp CTA icon ────────────────────────────────────────────── */

  /* Modifier, not a change to the shared .btn: that one is inline-block and is
     used by every button on the site. This seats the WhatsApp mark to the left
     of the label. currentColor lets the glyph inherit the button's white text
     on --color-primary-fill. */
  .btn-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* The WhatsApp mark is the recognizable filled brand glyph, not one of the
     site's stroked line icons, so it is painted with fill rather than stroke. */
  .btn-icon svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
    stroke: none;
    margin-bottom: 0.13rem;
  }

  /* The channel card carries the same filled mark. The generic .ch-icon svg
     rule paints line icons with stroke and fill:none, so this overrides it to
     fill in the accent instead. */
  .ch-icon.ch-icon-brand svg {
    fill: var(--color-primary-text);
    stroke: none;
  }

  /* ── The hero ornament ────────────────────────────────────────────────── */

  .preview-title {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-info-dark);
    margin-bottom: var(--space-2);
  }

  .bubble {
    position: relative;
    padding: var(--space-3) var(--space-3) var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-light);
    border-radius: var(--card-border-radius);
    border-bottom-left-radius: var(--border-radius-1);
    box-shadow: var(--elev-2);
  }

  .bubble p {
    margin: 0;
    color: var(--color-dark);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .preview-note {
    margin-top: var(--space-2);
    font-size: 0.88rem;
    color: var(--color-info-dark);
  }

  /* ── Antes de escribir ────────────────────────────────────────────────── */

  .before {
    --accent: var(--color-primary-fill);
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .before h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    margin-bottom: var(--space-2);
  }

  .before p {
    color: var(--color-dark-variant);
    max-width: var(--measure);
  }

  .before-glyphs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    align-items: center;
  }

  /* ── The two channels ─────────────────────────────────────────────────── */

  .channels {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .ch-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2);
    border-radius: var(--border-radius-2);
    background: color-mix(in srgb, var(--color-primary) 13%, var(--color-white));
  }
  .ch-icon svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: var(--color-primary-text);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .channels h2 {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  .channels p {
    color: var(--color-dark-variant);
    font-size: 0.98rem;
    margin-bottom: var(--space-2);
  }

  .ch-link {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  li.card .ch-phone {
    font-weight: 600;
    color: var(--color-primary-text);
  }
  @media (min-width: 760px) {
    .channels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .before {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
      align-items: center;
      gap: var(--space-5);
    }
  }
</style>
